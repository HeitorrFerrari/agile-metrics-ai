# Copy to .env and fill in.

# --- Azure DevOps ---
# PAT needs at least: Work Items (Read), Analytics (Read)
AZURE_DEVOPS_ORG=my-org
AZURE_DEVOPS_PROJECT=my-project
AZURE_DEVOPS_TEAM=my-team
AZURE_DEVOPS_PAT=

# --- Anthropic (narrative / coaching layer only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Board semantics ---
# Maps your board's columns to normalized column types. See board_config.example.yaml
BOARD_CONFIG_PATH=./board_config.yaml
