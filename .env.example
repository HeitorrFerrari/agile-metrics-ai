# Copie para .env e preencha.

# --- Azure DevOps ---
# O PAT precisa de pelo menos: Work Items (Read), Analytics (Read)
AZURE_DEVOPS_ORG=my-org
AZURE_DEVOPS_PROJECT=my-project
AZURE_DEVOPS_TEAM=my-team
AZURE_DEVOPS_PAT=

# --- Anthropic (só a camada de narrativa / coaching) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Semântica do quadro ---
# Mapeia as colunas do seu quadro para os tipos normalizados. Veja board_config.example.yaml
BOARD_CONFIG_PATH=./board_config.yaml
